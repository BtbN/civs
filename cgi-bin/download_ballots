#!@PERL@

use strict;
use warnings;

use lib '@CGIBINDIR@';
use civs_common;
use algorithms;
use CGI qw(:standard -utf8);
use Digest::MD5 qw(md5_hex);
use POSIX qw(strftime);
use DB_File;
use beatpath;
use cschulze;
use Socket;
use IO::Handle;

my $thisurl = $civs_bin_path."/download_ballots@PERLEXT@";

use election;

if (!IsWellFormedElectionID) {
    error("The poll identifier \"$election_id\" is not valid.");
}

if (!IsStarted) {
    error("This poll does not exist or has not been started");
}

my $result_key = bytesParam('rkey');

if (!param('admin_key') || param('admin_key') ne '@ADMIN_KEY@') {
    # Ballots are not released before the poll closes, whether or not it is a
    # public poll: until then they would show a voter how others have voted.
    if (!IsStopped) {
	error("This poll has not yet been closed");
    }

    if ($ballot_reporting ne 'yes') {
	error("Ballot reporting is not enabled for this poll");
    }

    # The ballots are at least as sensitive as the tally, so a poll whose
    # results are restricted must demand the same key here that results does.
    if ($restrict_results eq 'yes' && !ResultKeyOK($result_key)) {
	ElectionLog("Election: $title ($election_id) : invalid attempt to download ballots (wrong key)");
	error("You do not have permission to download the ballots for this poll.");
    }
}

# The ballots can also be had in the format the cschulze program reads, so
# that the Schulze proportional ranking can be checked by running that
# program over them by hand.
my $dat = (param('format') || '') eq 'dat';

print header(-type=>'application/text',
             -attachment=>($dat ? 'civs_ballots.dat' : 'civs_ballots.csv'));

my @voters = split /\n/, $vdata{'recorded_voters'};
fisher_yates_shuffle(\@voters);  # permute @voters to improve anonymity

# recorded_vote is a comma separated list of the ranks that the voter
# assigned to candidates. Element i of the list corresponds to candidate i.
my @ballots;
foreach my $voter_key (@voters) {
    my $recorded_vote = $vdata{$voter_key};
    next unless defined($recorded_vote);
    push @ballots, [split /,/, $recorded_vote];
}

if ($dat) {
    cschulze::write_ballots(\*STDOUT, \@choices, \@ballots);
} else {
    # print the list of candidate names
    print join(',', @choices), "\n";
    foreach my $ballot (@ballots) {
        print join(',', @{$ballot}), "\n";
    }
}

exit 0;

sub error {
    my $msg = shift;
    HTML_Header("CIVS Ballot Download");
    CIVS_Header("CIVS Ballot Download");
    print h2("Error");
    print p($msg);
    print end_html();

    exit 0;
}

